{
  "name": "broscafe-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env preview --port 8801 --test-scheduled --var REDIRECT_TO:",
    "check": "tsc --noEmit",
    "db:local": "wrangler d1 execute broscafe-preview --env preview --local --file schema.sql",
    "db:remote": "wrangler d1 execute broscafe --remote --file schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/node-forge": "1.3.14",
    "typescript": "^6.0.3",
    "wrangler": "^4.161.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "fflate": "0.8.3",
    "node-forge": "1.4.3"
  }
}
