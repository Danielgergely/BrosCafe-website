# ─────────────────────────────────────────────────────────────────────────
# Bros Cafe API configuration
# Copy to .env and fill in. Every value the backend reads is listed here;
# app/config.py is the only place that touches the environment.
# ─────────────────────────────────────────────────────────────────────────

# ── Required ───────────────────────────────────────────────────────────
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=broscafe
# Signs staff and customer sessions. Generate with: openssl rand -hex 32
JWT_SECRET=

# Public origin of the front end. Magic-link emails and the Apple Wallet
# web-service callback URL are built from this, so it must be the real
# https origin in production.
FRONTEND_URL=http://localhost:3000

# ── Admin account (created/kept in sync on every startup) ──────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── CORS ───────────────────────────────────────────────────────────────
# Comma-separated origins. "*" is fine locally, never in production.
CORS_ORIGINS=http://localhost:3000

# ── Content ────────────────────────────────────────────────────────────
# true  → every restart re-seeds products and journal posts from
#         backend/data/*.json, so editing a price is a git push.
# Items edited in /admin are skipped by the seeder, so leaving this on is safe:
# git owns the baseline, the dashboard owns anything someone has touched there.
# `python -m app.seed --force` deliberately puts the files back in charge.
SEED_ON_STARTUP=false

# ── Uploaded media ─────────────────────────────────────────────────────
# Where photos uploaded through /admin are written. MUST be a persistent
# volume — these files exist nowhere else, so a container-local path loses
# every image on redeploy. Back it up alongside the database.
MEDIA_DIR=/data/media
MAX_UPLOAD_MB=20

# ── Loyalty programme ──────────────────────────────────────────────────
STAMPS_REQUIRED=4
# Café-local grand opening moment. Drives /api/opening/status, every
# countdown and the on-site copy — change it here only.
OPENING_DATETIME=2026-09-16T08:00:00
CAFE_TIMEZONE=Europe/Budapest

# ── Session lifetimes ──────────────────────────────────────────────────
STAFF_TOKEN_DAYS=7
CUSTOMER_TOKEN_DAYS=30
MAGIC_LINK_MINUTES=20

# ── Café details (served at /api/cafe, shown across the site) ──────────
CAFE_NAME=Bros Cafe
CAFE_ADDRESS=1132 Budapest, Csanády u. 4.b
CAFE_INSTAGRAM=@broscafe
CAFE_PHONE=
CAFE_EMAIL=hello@broscafe.hu
CAFE_HOURS_WEEKDAYS=Mon–Fri · 7:30–19:00
CAFE_HOURS_WEEKEND=Sat–Sun · 9:00–18:00

# ── Transactional email ────────────────────────────────────────────────
# Without a key, magic links are written to the log instead of sent
# (development only — see app/routers/customer_auth.py).
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=Bros Cafe
EMAIL_BASE_URL=https://integrations.emergentagent.com

# ── Apple Wallet (all optional; passes stay off until configured) ──────
# Flip on only once the certificate chain below verifies.
APPLE_PASS_CONFIGURED=false
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.com.broscafe.loyalty

# Signing identity — supply ONE of these three shapes:
#  1. PEM file paths (how this project deploys)
APPLE_CERT_PEM_PATH=certs/pass.pem
APPLE_KEY_PEM_PATH=certs/ios-private-key.pem
#  2. inline PEM strings
# APPLE_CERTIFICATE=
# APPLE_PRIVATE_KEY=
#  3. a .p12 bundle
# APPLE_PASS_CERT_P12_PATH=
# APPLE_CERTIFICATE_PASSWORD=

# Apple WWDR intermediate certificate (G4).
APPLE_WWDR_CERT_PATH=certs/wwdr.pem
# APPLE_WWDR_CERTIFICATE=

# Override only to test against Apple's sandbox push endpoint.
# APNS_HOST=https://api.sandbox.push.apple.com

# ── Google Wallet (Android; optional, off until configured) ────────────
# Setup: create a Google Cloud project, enable the Google Wallet API, make a
# service account, then get an Issuer ID from the Google Pay & Wallet Console
# and grant that service account access to it.
GOOGLE_WALLET_CONFIGURED=false
# From the Google Pay & Wallet Console (a long number).
GOOGLE_ISSUER_ID=
# Supply ONE of these. The file form is preferred on a server.
GOOGLE_SERVICE_ACCOUNT_PATH=certs/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# Shared template for every pass; change only if you want a fresh class.
GOOGLE_WALLET_CLASS_SUFFIX=broscafe_loyalty
# Publicly reachable https logo, at least 660x660. Shown on the pass.
GOOGLE_WALLET_LOGO_URL=
