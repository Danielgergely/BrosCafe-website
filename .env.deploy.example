# ─────────────────────────────────────────────────────────────────────────
# Deployment environment for docker-compose.yml
#
# Copy this twice on the server and fill each in:
#     .env.stage   →  https://stage.broscafe.hu   (branch: stage)
#     .env.prod    →  https://broscafe.hu         (branch: main)
#
# Then:
#     docker compose --env-file .env.stage -p broscafe-stage up -d --build
#     docker compose --env-file .env.prod  -p broscafe-prod  up -d --build
#
# Keep both files OFF git — they hold secrets. Only this example is committed.
# ─────────────────────────────────────────────────────────────────────────

# ── Which environment is this ──────────────────────────────────────────
# Separate databases so stage can never read or corrupt real members.
DB_NAME=broscafe_prod
# The port this environment's nginx binds on localhost. Give stage a
# different one (e.g. 8081) so both can run on one server.
HOST_PORT=8080

# ── The public origin ──────────────────────────────────────────────────
# MUST be the final https URL, with no trailing slash. Two things are built
# from it: the magic-link sign-in URLs, and the Apple Wallet service URL that
# is burned into every pass you issue. Changing it later breaks every pass
# already on a customer's phone. Decide once.
FRONTEND_URL=https://broscafe.hu

# ── Secrets ────────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Content ────────────────────────────────────────────────────────────
# true  → every deploy re-seeds products and journal posts from
#         backend/data/*.json, so editing a price or an image is a git push.
# false → the database is the source of truth; edit through /admin instead.
#         Switch to false once you start editing products in the admin UI,
#         or a deploy will overwrite those edits.
SEED_ON_STARTUP=true

# ── Resources ──────────────────────────────────────────────────────────
# MongoDB cache ceiling, in GB. Default 0.5 is ample for a café's loyalty
# data and leaves room for the frontend build on a 4 GB server. Raise it if
# the member list grows into the tens of thousands.
MONGO_CACHE_GB=0.5

# ── Loyalty programme ──────────────────────────────────────────────────
STAMPS_REQUIRED=4
OPENING_DATETIME=2026-09-24T07:30:00
CAFE_TIMEZONE=Europe/Budapest

# ── Café details (shown across the site) ───────────────────────────────
CAFE_NAME=Bros Cafe
CAFE_ADDRESS=1132 Budapest, Csanády u. 4.b
CAFE_INSTAGRAM=@broscafe
CAFE_EMAIL=hello@broscafe.hu
CAFE_HOURS_WEEKDAYS=Mon–Fri · 7:30–19:00
CAFE_HOURS_WEEKEND=Sat–Sun · 9:00–18:00

# ── Transactional email ────────────────────────────────────────────────
# Without a key, magic links are only written to the container log — nobody
# can sign in. This is a launch blocker; see the handover doc.
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=Bros Cafe

# ── Apple Wallet ───────────────────────────────────────────────────────
# Leave false until the certificate chain verifies on the server.
APPLE_PASS_CONFIGURED=false
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.com.broscafe.loyalty
# Host directory holding pass.pem, ios-private-key.pem and wwdr.pem.
# Mounted read-only into the container; never committed.
CERTS_DIR=/srv/broscafe/certs
